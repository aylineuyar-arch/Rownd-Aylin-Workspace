# Private local-only RFI/RFP archive — highly sensitive, must never be
# committed or pushed. Keep the folder discoverable via .gitkeep/README.md,
# but ignore every real file dropped into it.
Rownd/private-rfi-archive/*
!Rownd/private-rfi-archive/.gitkeep
!Rownd/private-rfi-archive/README.md

# Hashed password for the archive server's HTTP Basic Auth — local to this
# machine only, never committed.
Rownd/.archive_auth_hash

# Encryption-at-rest key for archive file contents — local to this
# machine only, never committed. Losing this file makes every encrypted
# file in the archive permanently unrecoverable, so back it up privately
# if that matters to you; it is never backed up by this repo.
Rownd/.archive_enc_key
